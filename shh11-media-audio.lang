[zh-cn]
name = "媒体音频提取器"
auth = "shh"
descript = "从 TNAS 上的媒体文件中提取音轨。应用内直接解析 MP4 / MOV / M4A（ISO-BMFF）与 MKV / WebM（EBML）容器，列出每条轨道编码、语言、声道数与比特率，然后无损写出选中的音轨——原始编码流直接复制，不重新编码，因此没有质量损失且速度快。输出到你自己指定的目录，批量模式可遍历整个目录树。同时支持读取 WAV / FLAC / MP3 / OGG 的元数据与时长。全部在本机离线完成。若系统上存在 ffmpeg，管理员可额外启用转码预设（MP3 128/192/320k、FLAC、WAV、M4A、OPUS）。"
release_note = "1. 首次发布。"
important = "默认提取为无损流复制，绝不会修改源文件。"

[zh-hk]
name = "媒體音訊提取器"
auth = "shh"
descript = "從 TNAS 上的媒體檔案中提取音軌。應用內直接解析 MP4 / MOV / M4A（ISO-BMFF）與 MKV / WebM（EBML）容器，列出每條軌道編碼、語言、聲道數與位元率，然後無損寫出選中的音軌——原始編碼流直接複製，不重新編碼，因此沒有品質損失且速度快。輸出到你自己指定的目錄，批次模式可遍歷整個目錄樹。同時支援讀取 WAV / FLAC / MP3 / OGG 的元資料與時長。全部在本機離線完成。若系統上存在 ffmpeg，管理員可額外啟用轉碼預設（MP3 128/192/320k、FLAC、WAV、M4A、OPUS）。"
release_note = "1. 首次發佈。"
important = "預設提取為無損流複製，絕不會修改來源檔案。"

[en-us]
name = "Media Audio Extractor"
auth = "shh"
descript = "Extracts audio tracks from media files on your TNAS. Parses MP4 / MOV / M4A and MKV / WebM containers inside the application, lists every track with codec, language, channels and bitrate, then writes the selected track out losslessly by copying the original encoded stream, so nothing is re-encoded. Batch mode walks a whole folder tree. Also reads metadata from WAV / FLAC / MP3 / OGG. Runs locally and offline; transcoding presets need ffmpeg."
release_note = "1. Initial release."
important = "Default extraction is a lossless stream copy. Source files are never modified."

[fr-fr]
name = "Extracteur audio multimédia"
auth = "shh"
descript = "Extrait les pistes audio des médias du TNAS. Analyse en interne les conteneurs MP4 / MOV / M4A et MKV / WebM, affiche codec, langue, canaux et débit de chaque piste, puis écrit la piste choisie par copie directe du flux, sans réencodage : aucune perte de qualité, et rapide. Sortie vers le dossier de votre choix ; mode par lot inclus. Lit aussi les métadonnées et durées WAV / FLAC / MP3 / OGG. Tout se fait hors ligne. Si ffmpeg est présent, des préréglages de transcodage sont activables."
release_note = "1. Première version."
important = "L'extraction se fait par défaut en copie de flux sans perte ; les fichiers sources ne sont jamais modifiés."

[de-de]
name = "Medien-Audioextraktor"
auth = "shh"
descript = "Extrahiert Audiospuren aus Mediendateien auf Ihrem TNAS. Analysiert die Container MP4 / MOV / M4A und MKV / WebM direkt in der App, zeigt Codec, Sprache, Kanäle und Bitrate jeder Spur und schreibt die gewählte Spur als direkte Stromkopie, ohne Neukodierung: kein Qualitätsverlust, und schnell. Ausgabe in einen Ordner Ihrer Wahl, Stapelmodus inklusive. Liest auch Metadaten und Dauer von WAV / FLAC / MP3 / OGG. Alles läuft offline. Ist ffmpeg vorhanden, lassen sich Transkodier-Voreinstellungen aktivieren."
release_note = "1. Erstveröffentlichung."
important = "Die Extraktion erfolgt standardmäßig als verlustfreie Stromkopie; Quelldateien werden nie verändert."

[it-it]
name = "Estrattore audio multimediale"
auth = "shh"
descript = "Estrae le tracce audio dai file multimediali del TNAS. Analizza internamente i contenitori MP4 / MOV / M4A e MKV / WebM, mostra codec, lingua, canali e bitrate di ogni traccia, poi scrive la traccia scelta copiando direttamente il flusso, senza ricodifica: nessuna perdita di qualità, e veloce. Output nella cartella che preferisci, con modalità in blocco. Legge anche metadati e durata di WAV / FLAC / MP3 / OGG. Tutto in locale, offline. Se ffmpeg è presente, si possono attivare preset di transcodifica."
release_note = "1. Prima versione."
important = "L'estrazione è per impostazione predefinita una copia di flusso senza perdita; i file di origine non vengono mai modificati."

[es-es]
name = "Extractor de audio multimedia"
auth = "shh"
descript = "Extrae las pistas de audio de los archivos multimedia del TNAS. Analiza internamente los contenedores MP4 / MOV / M4A y MKV / WebM, muestra códec, idioma, canales y bitrate de cada pista y escribe la pista elegida copiando el flujo directamente, sin recodificar: sin pérdida de calidad y rápido. Salida a la carpeta que elijas, con modo por lotes. También lee metadatos y duración de WAV / FLAC / MP3 / OGG. Todo en local, sin conexión. Si hay ffmpeg, pueden activarse ajustes de transcodificación."
release_note = "1. Primera versión."
important = "La extracción es por defecto una copia de flujo sin pérdida; los archivos de origen nunca se modifican."

[hu-hu]
name = "Média hangkinyerő"
auth = "shh"
descript = "Hangsávokat nyer ki a TNAS médiafájljaiból. Az MP4 / MOV / M4A és MKV / WebM konténereket maga az alkalmazás elemzi, kilistázza az egyes sávok kodekjét, nyelvét, csatornáit és bitrátáját, majd a kiválasztott sávot közvetlen adatfolyam-másolással írja ki, újrakódolás nélkül: nincs minőségvesztés, és gyors. A kimenet az Ön által megadott mappába kerül, kötegelt módban is. Beolvassa a WAV / FLAC / MP3 / OGG metaadatait és hosszát is. Minden offline. Ha van ffmpeg, átkódolási előbeállítások kapcsolhatók be."
release_note = "1. Első kiadás."
important = "A kinyerés alapértelmezésben veszteségmentes adatfolyam-másolás; a forrásfájlok soha nem módosulnak."

[ja-jp]
name = "メディア音声抽出"
auth = "shh"
descript = "TNAS 上のメディアファイルから音声トラックを取り出します。MP4 / MOV / M4Aと MKV / WebMのコンテナーをアプリ自身が解析し、各トラックのコーデック・言語・チャンネル数・ビットレートを一覧表示します。選んだトラックは符号化ストリームをそのまま複製して書き出すため、再エンコードはなく、品質を損なわず高速です。出力先は任意のフォルダーを指定でき、バッチ処理にも対応。WAV / FLAC / MP3 / OGG のメタデータと長さも読み取ります。すべてオフラインで動作します。ffmpeg があれば、トランスコードのプリセットも有効にできます。"
release_note = "1. 初回リリース。"
important = "既定ではロスレスのストリームコピーで抽出し、元ファイルは一切変更しません。"

[ko-kr]
name = "미디어 오디오 추출기"
auth = "shh"
descript = "TNAS의 미디어 파일에서 오디오 트랙을 추출합니다. MP4 / MOV / M4A(ISO-BMFF)와 MKV / WebM(EBML) 컨테이너를 앱이 직접 분석해 각 트랙의 코덱, 언어, 채널, 비트레이트를 보여주고, 선택한 트랙은 원본 스트림을 그대로 복사해 기록하므로 재인코딩이 없어 품질 손실이 없고 빠릅니다. 출력 폴더는 직접 지정할 수 있으며 일괄 모드도 지원합니다. WAV / FLAC / MP3 / OGG의 메타데이터와 길이도 읽습니다. 모든 처리는 오프라인입니다. ffmpeg가 있으면 변환 프리셋을 켤 수 있습니다."
release_note = "1. 최초 릴리스."
important = "기본 추출 방식은 무손실 스트림 복사이며, 원본 파일은 절대 수정되지 않습니다."

[pl-pl]
name = "Ekstraktor audio z multimediów"
auth = "shh"
descript = "Wydobywa ścieżki audio z plików multimedialnych na TNAS. Aplikacja sama analizuje kontenery MP4 / MOV / M4A oraz MKV / WebM, pokazuje kodek, język, kanały i przepływność każdej ścieżki, a wybraną zapisuje przez bezpośrednie kopiowanie strumienia, bez ponownego kodowania: bez utraty jakości i szybko. Zapis do wskazanego folderu, z trybem wsadowym. Czyta też metadane i długość WAV / FLAC / MP3 / OGG. Wszystko lokalnie, offline. Jeśli dostępny jest ffmpeg, można włączyć presety transkodowania."
release_note = "1. Pierwsze wydanie."
important = "Domyślnie ekstrakcja to bezstratne kopiowanie strumienia; pliki źródłowe nigdy nie są zmieniane."

[ru-ru]
name = "Извлечение аудио из медиа"
auth = "shh"
descript = "Извлекает звуковые дорожки из медиафайлов на TNAS. Приложение само разбирает контейнеры MP4 / MOV / M4A и MKV / WebM, показывает кодек, язык, каналы и битрейт каждой дорожки, а выбранную записывает прямой копией потока, без перекодирования: без потери качества и быстро. Вывод в указанную вами папку, есть пакетный режим. Читает также метаданные и длительность WAV / FLAC / MP3 / OGG. Всё работает офлайн. Если есть ffmpeg, можно включить профили перекодирования."
release_note = "1. Первый выпуск."
important = "По умолчанию извлечение выполняется прямой копией потока без потерь; исходные файлы никогда не изменяются."

[tr-tr]
name = "Medya ses ayıklayıcı"
auth = "shh"
descript = "TNAS cihazınızdaki medya dosyalarından ses parçalarını çıkarır. MP4 / MOV / M4A ve MKV / WebM kapsayıcılarını uygulama kendi çözümler, her parçanın kodek, dil, kanal ve bit hızını listeler; seçtiğiniz parçayı akışı doğrudan kopyalayarak yazar, yeniden kodlama yoktur: kalite kaybı olmaz ve hızlıdır. Çıktıyı kendi seçtiğiniz klasöre verir, toplu kip desteklenir. WAV / FLAC / MP3 / OGG üst verilerini ve süresini de okur. Her şey çevrimdışıdır. ffmpeg varsa dönüştürme ön ayarları açılabilir."
release_note = "1. İlk sürüm."
important = "Ayıklama varsayılan olarak kayıpsız akış kopyasıdır; kaynak dosyalar asla değiştirilmez."

[pt-pt]
name = "Extrator de áudio multimédia"
auth = "shh"
descript = "Extrai as faixas de áudio dos ficheiros multimédia do TNAS. A aplicação analisa internamente os contentores MP4 / MOV / M4A e MKV / WebM, mostra código, idioma, canais e débito de cada faixa e grava a faixa escolhida copiando o fluxo diretamente, sem recodificar: sem perda de qualidade e rápido. Saída para a pasta que escolher, com modo em lote. Lê também metadados e duração de WAV / FLAC / MP3 / OGG. Tudo localmente, sem rede. Se existir ffmpeg, podem ativar-se predefinições de transcodificação."
release_note = "1. Primeira edição."
important = "A extração é, por predefinição, uma cópia de fluxo sem perdas; os ficheiros de origem nunca são alterados."
